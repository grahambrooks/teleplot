---
source: tests/kibana.rs
expression: yaml(&read(path))
---
---
id: edge-legacy-indexpattern
title: Lens with pre-8.6 indexpattern datasource
description: "Edge case: Lens with pre-8.6 indexpattern datasource"
time:
  from: now-90d/d
  to: now
panels:
- id: lead-time
  title: Change lead time (median)
  grid:
    x: 12
    y: 4
    w: 12
    h: 7
  content:
    type: chart
    kind: metric
    query:
      language: kql
      text: "is_rework : false"
    layers:
    - id: layer-lead-time
      data_view:
        index: delivery-deployments
        time_field: deployed_at
      columns:
      - id: lt-median
        label: Median lead time
        op: median
        field: change_lead_time_hours
        format:
          kind: number
          decimals: 1
          suffix: " h"
      encoding:
        as: metric
        value: lt-median
