---
id: edge-lucene-and-filters
title: Lucene query with assorted filter pills
description: "Edge case: Lucene query with assorted filter pills"
time:
  from: now-90d/d
  to: now
query:
  language: lucene
  text: result:failure OR change_lead_time_hours:[0 TO 24]
filters:
- field: team
  negate: true
  query:
    match_phrase:
      team: data
- label: disabled filter
  field: team
  disabled: true
  query:
    match_phrase:
      team: checkout
- label: custom DSL
  field: query
  query:
    range:
      change_lead_time_hours:
        lt: 500
- field: group
  query:
    bool:
      minimum_should_match: 1
      should:
      - match_phrase:
          group: payments
      - match_phrase:
          group: platform
panels:
- id: lead-time
  title: Change lead time (median)
  grid:
    x: 12
    y: 4
    w: 12
    h: 7
  content:
    type: chart
    kind: metric
    query:
      language: kql
      text: "is_rework : false"
    layers:
    - id: layer-lead-time
      data_view:
        index: delivery-deployments
        time_field: deployed_at
      columns:
      - id: lt-median
        label: Median lead time
        op: median
        field: change_lead_time_hours
        format:
          kind: number
          decimals: 1
          suffix: " h"
      encoding:
        as: metric
        value: lt-median
