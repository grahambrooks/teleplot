- id: bda054f7-2d06-4936-b461-365d1be621fa
  title: Daily comparison
  grid:
    x: 24
    y: 31
    w: 24
    h: 14
  content:
    type: chart
    kind: table
    layers:
    - id: 0731ee8b-31c5-4be9-92d9-69ee760465d7
      data_view:
        index: kibana_sample_data_ecommerce
        time_field: order_date
      columns:
      - id: 7bf8f089-1542-40bd-b349-45fdfc309ac6
        label: order_date
        op: date_histogram
        field: order_date
        interval: 1d
        include_empty: true
      - id: 826b2f39-b616-40b2-a222-972fdc1d7596
        label: This week
        op: sum
        field: taxful_total_price
      - id: cfd45c47-fc41-430c-9e7a-b71dc0c916b0
        label: 1 week ago
        op: sum
        field: taxful_total_price
        time_shift: 1w
      - id: bf51c1af-443e-49f4-a21f-54c87bfc5677
        label: Difference
        op: formula
        text: sum(taxful_total_price) - sum(taxful_total_price, shift='1w')
        expr:
          call: subtract
          args:
          - bf51c1af-443e-49f4-a21f-54c87bfc5677X0
          - bf51c1af-443e-49f4-a21f-54c87bfc5677X1
        format:
          kind: number
          decimals: 2
      - id: bf51c1af-443e-49f4-a21f-54c87bfc5677X0
        label: Part of Difference
        op: sum
        field: taxful_total_price
        helper: true
      - id: bf51c1af-443e-49f4-a21f-54c87bfc5677X1
        label: Part of Difference
        op: sum
        field: taxful_total_price
        time_shift: 1w
        helper: true
      encoding:
        as: table
        columns:
        - 7bf8f089-1542-40bd-b349-45fdfc309ac6
        - 826b2f39-b616-40b2-a222-972fdc1d7596
        - cfd45c47-fc41-430c-9e7a-b71dc0c916b0
        - bf51c1af-443e-49f4-a21f-54c87bfc5677
        styles:
        - column: bf51c1af-443e-49f4-a21f-54c87bfc5677
          color:
            mode: text
            stops:
            - from: 0.0
              color: "#23be8f"
            - from: 20.0
              color: "#9dedce"
            - from: 40.0
              color: "#fcd279"
            - from: 60.0
              color: "#ffc0b8"
            - from: 80.0
              color: "#f66d64"
            percent: true
