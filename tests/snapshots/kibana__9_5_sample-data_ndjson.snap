- id: 21bb0939-ee09-4021-8848-6552b3a6a788
  grid:
    x: 0
    y: 47
    w: 24
    h: 13
  content:
    type: chart
    kind: table
    layers:
    - id: 98067b05-c0ba-4c52-a12a-e9ac195c728c
      data_view:
        index: kibana_sample_data_logs
        time_field: "@timestamp"
      esql:
        query: |-
          FROM kibana_sample_data_logs
          | SORT @timestamp
          | EVAL t = now()
          | EVAL buckets = CASE(timestamp <= t AND timestamp >= t - 1 hour, "Last hour", "Other")
          | STATS sum = SUM(bytes), count = COUNT_DISTINCT(clientip) by buckets, extension.keyword
          | EVAL sum_last_hour = CASE(buckets == "Last hour", sum), sum_rest = CASE(buckets == "Other", sum), count_last_hour = CASE(buckets == "Last hour", count), count_rest = CASE(buckets == "Other", count)
          | STATS sum_last_hour = MAX(sum_last_hour), sum_rest = MAX(sum_rest), count_last_hour = MAX(count_last_hour), count_rest = MAX(count_rest) by buckets, extension.keyword
          | EVAL total_bytes = TO_DOUBLE(COALESCE(sum_last_hour, 0::LONG) + COALESCE(sum_rest, 0::LONG))
          | EVAL total_visits = TO_DOUBLE(COALESCE(count_last_hour, 0::LONG) + COALESCE(count_rest, 0::LONG))
          | KEEP count_last_hour, total_visits, total_bytes, sum_last_hour, extension.keyword
          | STATS count_last_hour = SUM(count_last_hour), total_visits  = SUM(total_visits), bytes_transform = SUM(total_bytes), bytes_transform_last_hour = SUM(sum_last_hour) BY extension.keyword
          | RENAME total_visits as `Unique Visits (Total)`, count_last_hour as `Unique Visits (Last hour)`, bytes_transform as `Bytes(Total)`, bytes_transform_last_hour as `Bytes(Last hour)`, extension.keyword as `Type`
          | SORT `Unique Visits (Total)` DESC
      columns:
      - id: 50616178-2ced-4297-9fd1-29ea50f788ab
        label: Bytes(Total)
        op: value
        field: Bytes(Total)
        format:
          kind: bytes
          decimals: 2
      - id: b6472710-4099-44e4-9e7d-acdef5b10752
        label: Bytes(Last hour)
        op: value
        field: Bytes(Last hour)
        format:
          kind: bytes
          decimals: 2
      - id: Unique Visits (Total)
        label: Unique Visits (Total)
        op: value
        field: Unique Visits (Total)
      - id: Unique Visits (Last hour)
        label: Unique Visits (Last hour)
        op: value
        field: Unique Visits (Last hour)
      - id: ee182e52-c961-4eb3-837f-d67a7750d96a
        label: Type
        op: value
        field: Type
      encoding:
        as: table
        columns:
        - Unique Visits (Last hour)
        - Unique Visits (Total)
        - 50616178-2ced-4297-9fd1-29ea50f788ab
        - b6472710-4099-44e4-9e7d-acdef5b10752
        - ee182e52-c961-4eb3-837f-d67a7750d96a
        styles:
        - column: Unique Visits (Last hour)
          color:
            mode: text
            stops:
            - from: 0.0
              color: "#24c292"
            - from: 20.0
              color: "#aee8d2"
            - from: 40.0
              color: "#fcd883"
            - from: 60.0
              color: "#ffc9c2"
            - from: 80.0
              color: "#f6726a"
        - column: Unique Visits (Total)
          color:
            mode: text
            stops:
            - from: 0.0
              color: "#24c292"
            - from: 20.0
              color: "#aee8d2"
            - from: 40.0
              color: "#fcd883"
            - from: 60.0
              color: "#ffc9c2"
            - from: 80.0
              color: "#f6726a"
- id: cbca842c-b9fa-4523-9ce0-14e350866e33
  title: "[Logs] Bytes distribution"
  grid:
    x: 24
    y: 47
    w: 24
    h: 13
  content:
    type: chart
    kind: xy
    layers:
    - id: efaebb4b-6893-46a3-8fae-0eecef93cfab
      data_view:
        index: kibana_sample_data_logs
        time_field: "@timestamp"
      esql:
        query: |-
          FROM kibana_sample_data_logs
          | INLINESTATS total_visits = COUNT()
          | STATS visits = COUNT() by bytes = bucket(bytes, 1000, 0, 100000), total_visits
          | EVAL percentage = (TO_DOUBLE(visits) / total_visits)
          | EVAL percentage = ROUND(percentage, 3)
          | DROP total_visits, visits
      columns:
      - id: percentage
        label: percentage
        op: value
        field: percentage
        format:
          kind: percent
          decimals: 1
      - id: 643e21d0-c836-4041-b283-85805993cabb
        label: bytes
        op: value
        field: bytes
      encoding:
        as: xy
        series: bar_stacked
        x: 643e21d0-c836-4041-b283-85805993cabb
        y:
        - percentage
        missing: gap
- id: 1d5f0b3f-d9d2-4b26-997b-83bc5ca3090b
  title: "[Logs] Errors by host"
  grid:
    x: 0
    y: 60
    w: 48
    h: 19
  content:
    type: chart
    kind: table
    layers:
    - id: 8d5e3fae-adad-4bfc-8ec2-a1926a447315
      data_view:
        index: kibana_sample_data_logs
        time_field: "@timestamp"
      esql:
        query: |-
          FROM kibana_sample_data_logs
          | KEEP bytes, clientip, url.keyword, response.keyword
          | EVAL type = CASE(TO_INTEGER(response.keyword) >= 400 and TO_INTEGER(response.keyword) < 500, "4xx", TO_INTEGER(response.keyword) >= 500, "5xx", "Other")
          | STATS Visits = COUNT(), Unique = COUNT_DISTINCT(clientip), p95 = percentile(bytes, 95), median = median(bytes) by type, url.keyword
          | EVAL count_4xx = CASE(type == "4xx", Visits), count_5xx = CASE(type == "5xx", Visits), count_rest =  CASE(type == "Other", Visits)
          | STATS count_4xx = SUM(count_4xx), count_5xx  = SUM(count_5xx), count_rest = SUM(count_rest), Unique = SUM(Unique),`95th percentile of bytes` = MAX(p95), `Median of bytes` = MAX(median), Visits = SUM(Visits) BY url.keyword
          | EVAL count_4xx = COALESCE(count_4xx, 0::LONG), count_5xx = COALESCE(count_5xx, 0::LONG), count_rest = COALESCE(count_rest, 0::LONG)
          | EVAL total_records = TO_DOUBLE(count_4xx + count_5xx + count_rest)
          | EVAL percentage_4xx = count_4xx / total_records, percentage_5xx = count_5xx / total_records
          | EVAL percentage_4xx = ROUND(percentage_4xx, 3)
          | EVAL percentage_5xx = ROUND(percentage_5xx, 3)
          | DROP count_4xx, count_rest, total_records
          | SORT percentage_5xx DESC
          | RENAME percentage_4xx as `HTTP 4xx`, percentage_5xx as `HTTP 5xx`
      columns:
      - id: Unique
        label: Unique
        op: value
        field: Unique
      - id: ae2c85ad-c1a3-4f4a-a1e2-761060ef1136
        label: Visits
        op: value
        field: Visits
      - id: 95th percentile of bytes
        label: 95th percentile of bytes
        op: value
        field: 95th percentile of bytes
        format:
          kind: bytes
          decimals: 0
      - id: Median of bytes
        label: Median of bytes
        op: value
        field: Median of bytes
        format:
          kind: bytes
          decimals: 0
      - id: count_5xx
        label: HTTP 5xx
        op: value
        field: HTTP 5xx
        format:
          kind: percent
          decimals: 1
      - id: 0089839c-ab91-420e-bdec-9583ce4d6015
        label: HTTP 4xx
        op: value
        field: HTTP 4xx
        format:
          kind: percent
          decimals: 1
      - id: fc9b8ff9-47dc-4a68-9028-583ecd4cb865
        label: url.keyword
        op: value
        field: url.keyword
      encoding:
        as: table
        columns:
        - Unique
        - 95th percentile of bytes
        - Median of bytes
        - count_5xx
        - 0089839c-ab91-420e-bdec-9583ce4d6015
        - fc9b8ff9-47dc-4a68-9028-583ecd4cb865
        - ae2c85ad-c1a3-4f4a-a1e2-761060ef1136
