---
id: edf84fe0-e1a0-11e7-b6d5-4dc382ef7f5b
title: "[Logs] Web Traffic"
description: Analyze mock web traffic log data for Elastic's website
time:
  from: now-7d/d
  to: now
controls:
- id: 612f8db8-9ba9-41cf-a809-d133fe9b83a8
  title: Source Country
  field: geo.src
  data_view:
    index: kibana_sample_data_logs
    time_field: timestamp
- id: 9807212f-5078-4c42-879c-6f28b3033fc9
  title: OS
  field: machine.os.keyword
  data_view:
    index: kibana_sample_data_logs
    time_field: timestamp
panels:
- id: "4"
  title: "[Logs] Total Requests and Bytes"
  grid:
    x: 0
    y: 14
    w: 24
    h: 18
  content:
    type: placeholder
    kind: map
    reason: out_of_scope
    detail: map panels are not in the MVP
- id: "11"
  grid:
    x: 36
    y: 0
    w: 12
    h: 7
  content:
    type: chart
    kind: metric
    layers:
    - id: 323d8ae0-0a4e-4540-84e2-0d36c8f15b46
      data_view:
        index: kibana_sample_data_logs
        time_field: "@timestamp"
      esql:
        query: >-
          FROM kibana_sample_data_logs | STATS COUNT_DISTINCT(clientip) | RENAME
          `COUNT_DISTINCT(clientip)` as `Unique Visitors`
      columns:
      - id: Unique Visitors
        label: Unique Visitors
        op: value
        field: Unique Visitors
      encoding:
        as: metric
        value: Unique Visitors
- id: "14"
  title: "[Logs] Machine OS and Destination Sankey Chart"
  grid:
    x: 24
    y: 14
    w: 24
    h: 33
  content:
    type: placeholder
    kind: vega
    reason: out_of_scope
    detail: legacy vega visualizations are not in the MVP
- id: "15"
  title: "[Logs] Response Codes Over Time + Annotations"
  grid:
    x: 0
    y: 7
    w: 24
    h: 7
  content:
    type: chart
    kind: xy
    layers:
    - id: b38fe501-4b47-4de8-a423-6656d1162174
      data_view:
        index: kibana_sample_data_logs
        time_field: timestamp
      columns:
      - id: 8986e393-d24f-49b0-96ca-118fd66d75e5
        label: timestamp
        op: date_histogram
        field: timestamp
        interval: auto
        include_empty: true
      - id: 43f5bb0f-c6da-43a0-8a0a-50e9838ed34b
        label: Filters
        op: filters
        filters:
        - label: HTTP 2xx and 3xx
          query:
            language: kql
            text: response.keyword >= 200 and response.keyword < 400
        - label: HTTP 4xx
          query:
            language: kql
            text: response.keyword >= 400 and response.keyword < 500
        - label: HTTP 5xx
          query:
            language: kql
            text: response.keyword >= 500
      - id: 896c5eb2-81c5-44f1-a4a1-57344161ea62
        label: Response Code Count
        op: count
      encoding:
        as: xy
        series: area_percentage_stacked
        x: 8986e393-d24f-49b0-96ca-118fd66d75e5
        y:
        - 896c5eb2-81c5-44f1-a4a1-57344161ea62
        split: 43f5bb0f-c6da-43a0-8a0a-50e9838ed34b
        missing: gap
    annotations:
    - id: bd7548a0-2223-11e8-832f-d5027f3c8a47
      label: Event
      data_view:
        index: kibana_sample_data_logs
        time_field: timestamp
      query:
        language: lucene
        text: tags:error AND tags:security
      text: geo.src
      ignore_global_filters: true
      color: "#D33115"
- id: 343f0bef-0b19-452e-b1c8-59beb18b6f0c
  grid:
    x: 0
    y: 0
    w: 24
    h: 7
  content:
    type: markdown
    text: |-
      ## Sample Logs Data
      This dashboard contains sample data for you to play with. You can view it, search it, and interact with the visualizations. For more information about Kibana, check our [docs](https://www.elastic.co/guide/en/kibana/current/index.html).
- id: bb94016e-f4a6-49ca-87a9-296a2869d570
  grid:
    x: 24
    y: 0
    w: 12
    h: 7
  content:
    type: chart
    kind: metric
    layers:
    - id: 64a4cc71-c831-4644-9022-3fc833b8be77
      data_view:
        index: kibana_sample_data_logs
        time_field: "@timestamp"
      esql:
        query: FROM kibana_sample_data_logs | STATS COUNT(*) | RENAME `COUNT(*)` as `Visits`
      columns:
      - id: Visits
        label: Visits
        op: value
        field: Visits
      encoding:
        as: metric
        value: Visits
- id: 8c1456d4-1993-4ba2-b701-04aca02c9fef
  grid:
    x: 36
    y: 7
    w: 12
    h: 7
  content:
    type: chart
    kind: metric
    layers:
    - id: 81ca7215-7fcf-4d72-98d7-911faade8c71
      data_view:
        index: kibana_sample_data_logs
        time_field: "@timestamp"
      esql:
        query: |-
          FROM kibana_sample_data_logs
          | EVAL type = CASE(TO_INTEGER(response.keyword) >= 500, "5xx", "Other")
          | STATS count = COUNT(*) by type
          | EVAL count_5xx = CASE(type == "5xx", count), count_rest = CASE(type == "Other", count)
          | DROP count, type
          | STATS count_5xx = MAX(count_5xx), count_rest = MAX(count_rest)
          | EVAL percentage = ROUND(count_5xx / TO_DOUBLE(count_5xx + count_rest), 3)
          | RENAME percentage as `HTTP 5xx (%)`
          | DROP count_5xx, count_rest
      columns:
      - id: HTTP 5xx (%)
        label: HTTP 5xx (%)
        op: value
        field: HTTP 5xx (%)
        format:
          kind: percent
          decimals: 2
      encoding:
        as: metric
        value: HTTP 5xx (%)
- id: 01d8e435-91c0-484f-a11e-856747050b0a
  grid:
    x: 24
    y: 7
    w: 12
    h: 7
  content:
    type: chart
    kind: metric
    layers:
    - id: bc54f0c9-40ec-4082-92f5-3d6a6fdc4463
      data_view:
        index: kibana_sample_data_logs
        time_field: "@timestamp"
      esql:
        query: |-
          FROM kibana_sample_data_logs
          | EVAL type = CASE(TO_INTEGER(response.keyword) >= 400 and TO_INTEGER(response.keyword) < 500, "4xx", "Other")
          | STATS count = COUNT(*) by type
          | EVAL count_4xx = CASE(type == "4xx", count), count_rest = CASE(type == "Other", count)
          | DROP count, type
          | STATS count_4xx = MAX(count_4xx), count_rest = MAX(count_rest)
          | EVAL percentage = ROUND(count_4xx / TO_DOUBLE(count_4xx + count_rest), 3)
          | RENAME percentage as `HTTP 4xx (%)`
          | DROP count_4xx, count_rest
      columns:
      - id: HTTP 4xx (%)
        label: HTTP 4xx (%)
        op: value
        field: HTTP 4xx (%)
        format:
          kind: percent
          decimals: 2
      encoding:
        as: metric
        value: HTTP 4xx (%)
