- id: d9495793-80ba-4a9a-b0e3-d1155ec99b09
  title: Transactions per day
  grid:
    x: 0
    y: 14
    w: 24
    h: 7
  content:
    type: chart
    kind: xy
    layers:
    - id: b6093a53-884f-42c2-9fcc-ba56cfb66c53
      data_view:
        index: kibana_sample_data_ecommerce
        time_field: order_date
      columns:
      - id: 15c45f89-a149-443a-a830-aa8c3a9317db
        label: order_date
        op: date_histogram
        field: order_date
        interval: 1d
        include_empty: true
      - id: 2b41b3d8-2f62-407a-a866-960f254c679d
        label: Total items
        op: sum
        field: products.quantity
      - id: eadae280-2da3-4d1d-a0e1-f9733f89c15b
        label: Last week
        op: sum
        field: products.quantity
        time_shift: 1w
      - id: ddc92e50-4d5c-413e-b91b-3e504889fa65
        label: Transactions
        op: count
      - id: 5e31e5d3-2aaa-4475-a130-3b69bf2f748a
        label: Tx. last week
        op: count
        time_shift: 1w
      encoding:
        as: xy
        series: line
        x: 15c45f89-a149-443a-a830-aa8c3a9317db
        y:
        - 2b41b3d8-2f62-407a-a866-960f254c679d
        - eadae280-2da3-4d1d-a0e1-f9733f89c15b
        - 5e31e5d3-2aaa-4475-a130-3b69bf2f748a
        - ddc92e50-4d5c-413e-b91b-3e504889fa65
