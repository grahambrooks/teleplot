- id: bdb525ab-270b-46f1-a847-dd29be19aadb
  title: "% of target revenue ($10k)"
  grid:
    x: 0
    y: 7
    w: 24
    h: 7
  content:
    type: chart
    kind: xy
    layers:
    - id: c7478794-6767-4286-9d65-1c0ecd909dd8
      data_view:
        index: kibana_sample_data_ecommerce
        time_field: order_date
      columns:
      - id: 8289349e-6d1b-4abf-b164-0208183d2c34
        label: order_date
        op: date_histogram
        field: order_date
        interval: 1d
        include_empty: true
      - id: 041db33b-5c9c-47f3-a5d3-ef5e255d1663
        label: "% of target ($10k)"
        op: formula
        text: sum(taxful_total_price) / 10000 - 1
        expr:
          call: subtract
          args:
          - call: divide
            args:
            - 041db33b-5c9c-47f3-a5d3-ef5e255d1663X0
            - 10000.0
          - 1.0
        format:
          kind: percent
          decimals: 0
      - id: 041db33b-5c9c-47f3-a5d3-ef5e255d1663X0
        label: Part of Weekly revenue
        op: sum
        field: taxful_total_price
        helper: true
      encoding:
        as: xy
        series: bar_stacked
        x: 8289349e-6d1b-4abf-b164-0208183d2c34
        y:
        - 041db33b-5c9c-47f3-a5d3-ef5e255d1663
        missing: gap
---
id: 7adfa750-4c81-11e8-b3d7-01146121b73d
title: "[Flights] Global Flight Dashboard"
description: >-
  Analyze mock flight data for ES-Air, Logstash Airways, Kibana Airlines and
  JetBeats
time:
  from: now-7d
  to: now
controls:
- id: 85b632c8-3b7b-408d-8223-b0caccf75bd3
  title: Origin City
  field: OriginCityName
  data_view:
    index: kibana_sample_data_flights
    time_field: timestamp
- id: d4dc9d2b-5850-402a-921d-8a2cd0107156
  title: Destination City
  field: DestCityName
  data_view:
    index: kibana_sample_data_flights
    time_field: timestamp
panels:
- id: "4"
  title: "[Flights] Flight Log"
  grid:
    x: 0
    y: 69
    w: 48
    h: 15
  content:
    type: placeholder
    kind: search
    reason: out_of_scope
    detail: search panels are not in the MVP
- id: "7"
  title: "[Flights] Delays & Cancellations"
  grid:
    x: 0
    y: 16
    w: 24
    h: 9
  content:
    type: chart
    kind: xy
    layers:
    - id: dc8cf715-b56b-4dd7-a624-7c3ef9e2f2ce
      data_view:
        index: kibana_sample_data_flights
        time_field: timestamp
      columns:
      - id: 6944431b-f90a-4dab-a282-0961cb97edd1
        label: timestamp
        op: date_histogram
        field: timestamp
        interval: auto
        include_empty: true
      - id: b9d6187b-8a7e-4c49-bffd-7a60cc075a4aX0
        label: Part of count(lucene='FlightDelay:true') / count(kql='*')
        op: count
        filter:
          language: lucene
          text: FlightDelay:true
        helper: true
      - id: b9d6187b-8a7e-4c49-bffd-7a60cc075a4aX1
        label: Part of count(lucene='FlightDelay:true') / count(kql='*')
        op: count
        filter:
          language: kql
          text: "*"
        helper: true
      - id: b9d6187b-8a7e-4c49-bffd-7a60cc075a4a
        label: Percent Delays
        op: formula
        text: count(lucene='FlightDelay:true') / count(kql='*')
        expr:
          call: divide
          args:
          - b9d6187b-8a7e-4c49-bffd-7a60cc075a4aX0
          - b9d6187b-8a7e-4c49-bffd-7a60cc075a4aX1
        format:
          kind: percent
      encoding:
        as: xy
        series: area
        x: 6944431b-f90a-4dab-a282-0961cb97edd1
        y:
        - b9d6187b-8a7e-4c49-bffd-7a60cc075a4a
        missing: gap
    annotations:
    - id: 53b7dff0-4c89-11e8-a66a-6989ad5a0a39
      label: Event
      data_view:
        index: kibana_sample_data_flights
        time_field: timestamp
      query:
        language: lucene
        text: FlightDelay:true AND Cancelled:true
      text: FlightDelay
      ignore_global_filters: true
      color: "#0062B1"
- id: "10"
  title: "[Flights] Delay Buckets"
  grid:
    x: 0
    y: 58
    w: 24
    h: 11
  content:
    type: chart
    kind: xy
    filters:
    - field: FlightDelayMin
      negate: true
      query:
