id: 722b74f0-b882-11e8-a6d9-e546fe2bba5f
title: "[eCommerce] Revenue Dashboard"
description: Analyze mock eCommerce orders and revenue
time:
  from: now-7d
  to: now
controls:
- id: 1ee1617f-fd8e-45e4-bc6a-d5736710ea20
  title: Manufacturer
  field: manufacturer.keyword
  data_view:
    index: kibana_sample_data_ecommerce
    time_field: order_date
- id: afa9fa0f-a002-41a5-bab9-b738316d2590
  title: Category
  field: category.keyword
  data_view:
    index: kibana_sample_data_ecommerce
    time_field: order_date
panels:
- id: "5"
  title: "[eCommerce] Promotion Tracking"
  grid:
    x: 0
    y: 21
    w: 24
    h: 10
  content:
    type: chart
    kind: xy
    layers:
    - id: e3b3cb5c-e3b1-497f-a5d5-fddb0dabc94e
      data_view:
        index: kibana_sample_data_ecommerce
        time_field: order_date
      columns:
      - id: f3cc8168-6360-4727-a410-a57f5a325091
        label: order_date
        op: date_histogram
        field: order_date
        interval: 12h
        include_empty: true
      - id: a69956c9-43cd-4756-a3c0-e93cb1502a0b
        label: Revenue Trousers
        op: sum
        field: taxful_total_price
        filter:
          language: lucene
          text: products.product_name:*trouser*
        format:
          kind: number
      encoding:
        as: xy
        series: line
        x: f3cc8168-6360-4727-a410-a57f5a325091
        y:
        - a69956c9-43cd-4756-a3c0-e93cb1502a0b
        missing: gap
    - id: 1d08a43c-8913-4692-a3e0-8d77902f6e46
      data_view:
        index: kibana_sample_data_ecommerce
        time_field: order_date
      columns:
      - id: 644b06ea-73a3-47b1-9b40-3035844c4621
        label: order_date
        op: date_histogram
        field: order_date
        interval: 12h
        include_empty: true
      - id: 9a3d8abd-81a5-40ae-9616-020d5a5b2ee2
        label: Revenue Watches
        op: sum
        field: taxful_total_price
        filter:
          language: lucene
          text: products.product_name:*watch*
        format:
          kind: number
      encoding:
        as: xy
        series: line
        x: 644b06ea-73a3-47b1-9b40-3035844c4621
        y:
        - 9a3d8abd-81a5-40ae-9616-020d5a5b2ee2
        missing: gap
    - id: 9725cdbd-a9f3-479f-a349-0f11244e5239
      data_view:
        index: kibana_sample_data_ecommerce
        time_field: order_date
      columns:
      - id: 6749b404-4784-4fd6-8bf6-5712e84c7310
        label: order_date
        op: date_histogram
        field: order_date
        interval: 12h
        include_empty: true
      - id: b5588228-9c46-4a4b-92ee-d140c327bca0
        label: Revenue Bags
        op: sum
        field: taxful_total_price
        filter:
          language: lucene
          text: products.product_name:*bag*
        format:
          kind: number
      encoding:
        as: xy
        series: line
        x: 6749b404-4784-4fd6-8bf6-5712e84c7310
        y:
        - b5588228-9c46-4a4b-92ee-d140c327bca0
        missing: gap
    - id: 2031d0f8-01fc-4009-b1ad-a7b7ca9266c0
      data_view:
        index: kibana_sample_data_ecommerce
        time_field: order_date
      columns:
      - id: 1b199cb1-b47f-48e6-b209-74eb81b303f5
        label: order_date
        op: date_histogram
        field: order_date
        interval: 12h
        include_empty: true
      - id: 985e05c0-3a0b-4e55-84bb-1f02128388a9
        label: Revenue Cocktail Dresses
        op: sum
        field: taxful_total_price
        filter:
          language: lucene
          text: products.product_name:*cocktail dress*
        format:
          kind: number
      encoding:
        as: xy
        series: line
        x: 1b199cb1-b47f-48e6-b209-74eb81b303f5
        y:
        - 985e05c0-3a0b-4e55-84bb-1f02128388a9
        missing: gap
    annotations:
    - id: c8c30be0-b88f-11e8-a451-f37365e9f268
      label: Event
      data_view:
        index: kibana_sample_data_ecommerce
        time_field: order_date
      query:
        language: lucene
        text: taxful_total_price:>250
      text: taxful_total_price
      ignore_global_filters: true
      color: "#194D33"
- id: "7"
  title: Sold Products per Day
  grid:
    x: 36
    y: 7
    w: 12
    h: 7
  time:
    from: now-7d
    to: now
  content:
    type: chart
    kind: metric
    layers:
    - id: 037375ae-9e23-4dd5-a4f0-5f117bb7dac1
      data_view:
        index: kibana_sample_data_ecommerce
        time_field: order_date
      columns:
      - id: c27bd77c-68e2-4d75-8fda-41c45d22f8d4X0
        label: Part of count() / (time_range() / 1000 / 60 / 60 / 24)
        op: count
        helper: true
      - id: c27bd77c-68e2-4d75-8fda-41c45d22f8d4X1
        label: Part of count() / (time_range() / 1000 / 60 / 60 / 24)
        op: time_range
        helper: true
      - id: c27bd77c-68e2-4d75-8fda-41c45d22f8d4
        label: Trxns / day
        op: formula
        text: count() / (time_range() / 1000 / 60 / 60 / 24)
        expr:
          call: divide
          args:
          - c27bd77c-68e2-4d75-8fda-41c45d22f8d4X0
          - call: divide
            args:
            - call: divide
              args:
              - call: divide
                args:
                - call: divide
                  args:
                  - c27bd77c-68e2-4d75-8fda-41c45d22f8d4X1
                  - 1000.0
                - 60.0
              - 60.0
            - 24.0
        format:
          kind: number
          compact: true
      - id: ce816876-e92d-4b1a-bbb0-ed7637fc0eea
        label: "Static value: 300"
        op: static_value
        value: 300.0
      encoding:
        as: metric
        value: c27bd77c-68e2-4d75-8fda-41c45d22f8d4
        max: ce816876-e92d-4b1a-bbb0-ed7637fc0eea
        progress: true
